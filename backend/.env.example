# ==============================================================================
# GAMERVOUlT BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTICE: NEVER commit real credentials, service accounts, or private keys.
# Set these variables in the Vercel Project Dashboard for preview and production.

# Server Configuration
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=https://freefireofficial.in,https://gamervoult.vercel.app

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=ff-store-4a61e
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@ff-store-4a61e.iam.gserviceaccount.com
# Provide the private key as a single-line string with literal \n escapes:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Payment Gateway Configuration
# Must match the webhook secret configured in the UPI Payment Gateway dashboard:
UPI_GATEWAY_WEBHOOK_SECRET=your_32_char_random_webhook_secret_here
UPI_GATEWAY_API_KEY=your_payment_gateway_api_key_here
UPI_GATEWAY_URL=https://personal-payment-gateway.onrender.com

# App Release & Update Verification (Phase 8 - CFG-03 Fail-Closed Integrity)
MINIMUM_ANDROID_VERSION_CODE=1
LATEST_ANDROID_VERSION_CODE=1
LATEST_ANDROID_VERSION_NAME=1.0.0
LATEST_APK_DOWNLOAD_URL=https://releases.gamervoult.com/gamervoult-v1.0.0.apk
LATEST_APK_SHA256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
LATEST_APK_SIZE_BYTES=24500000
APP_CHANGELOG="Official Gamervoult Android Release: Real-time escrow support, verified catalog, dynamic UPI payments."

# AI Copilot Configuration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

